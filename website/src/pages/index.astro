---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubjectCard from '../components/SubjectCard.astro';
import { getSubjects } from '../lib/content';

const subjects = getSubjects();
const recent = subjects.flatMap((subject) => subject.lessons.map((lesson) => ({ ...lesson, subjectName: subject.name })))
  .sort((a, b) => b.date.localeCompare(a.date) || a.title.localeCompare(b.title)).slice(0, 5);
const firstLesson = recent[0];
---
<BaseLayout title="Study">
  <div class="home-page page-enter">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy"><div class="eyebrow"><span class="eyebrow-spark">✦</span> A SPACE TO THINK CLEARLY</div><h1 id="home-title">Your personal<br /><span>learning system<span class="hero-period">.</span></span></h1><p>Keep every subject close, find your next lesson, and make room for the kind of progress that lasts.</p><a class="primary-button" href="#subjects">Explore your subjects <span aria-hidden="true">↗</span></a></div>
      <div class="hero-art" aria-hidden="true"><div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div><div class="hero-tile tile-back"><span>01</span><div class="tile-lines"><i></i><i></i><i></i></div></div><div class="hero-tile tile-front"><div class="tile-top"><span>STUDY NOTES</span><span>✦</span></div><div class="tile-quote">Small steps.<br /><em>Big ideas.</em></div><div class="tile-rule"></div><div class="tile-bottom"><span>LEARN SOMETHING NEW</span><span>↗</span></div></div><div class="hero-dot dot-one"></div><div class="hero-dot dot-two"></div></div>
    </section>

    <section class="continue-section" aria-labelledby="continue-heading"><div class="section-heading"><div><span class="section-kicker">YOUR JOURNEY</span><h2 id="continue-heading">Continue learning</h2></div><span class="section-assist">One step at a time</span></div>
      {firstLesson ? <a class="continue-card" id="continue-card" href={firstLesson.url}>
        <span class="continue-visual" aria-hidden="true"><span class="continue-visual-mark">✦</span><span class="continue-visual-number">01 / ∞</span></span>
        <span class="continue-copy"><span class="continue-label">CURRENT LESSON <span class="label-divider">/</span> <span id="continue-subject">{firstLesson.subjectName}</span></span><strong id="continue-title">{firstLesson.title}</strong><span class="continue-progress-row"><span id="continue-caption">Ready when you are</span><span id="continue-percent">0%</span></span><span class="progress-track"><span id="continue-progress"></span></span></span>
        <span class="continue-action" aria-hidden="true">Continue <span>↗</span></span>
      </a> : <div class="empty-state">Your next lesson will appear here when you add one to a subject.</div>}
    </section>

    <section class="study-dashboard" aria-labelledby="dashboard-heading"><div class="section-heading"><div><span class="section-kicker">YOUR MOMENTUM</span><h2 id="dashboard-heading">Study dashboard</h2></div><span class="section-assist">Progress you can see</span></div>
      <div class="dash-grid">
        <div class="dash-card dash-stats">
          <div class="dash-stat"><span class="dash-stat-value" id="dash-streak">0</span><span class="dash-stat-label">day streak</span></div>
          <div class="dash-stat"><span class="dash-stat-value" id="dash-visited">0</span><span class="dash-stat-label">lessons opened</span></div>
          <div class="dash-stat"><span class="dash-stat-value"><span id="dash-due-count">0</span></span><span class="dash-stat-label">cards due today</span></div>
        </div>
        <div class="dash-card"><span class="section-kicker">LAST 5 WEEKS</span><div class="dash-heat" id="dash-heat"></div><p class="dash-hint">Each square is a day you opened a lesson.</p></div>
        <div class="dash-card"><span class="section-kicker">SUBJECT PROGRESS</span><ul class="dash-progress" id="dash-progress"></ul></div>
        <div class="dash-card"><span class="section-kicker">REVIEWS DUE TODAY</span><ul class="dash-due" id="dash-due"></ul></div>
      </div>
      <div class="dash-subject-data" aria-hidden="true">
        {subjects.map((subject) => <span data-dash-subject={subject.name} data-dash-total={String(subject.lessons.length)} data-dash-urls={subject.lessons.map((lesson) => lesson.url).join('|')} />)}
        {subjects.flatMap((subject) => subject.lessons.map((lesson) => <span data-dash-lesson={lesson.url} data-dash-lesson-title={lesson.title} />))}
      </div>
    </section>

    <section id="subjects" class="subjects-section" aria-labelledby="subjects-heading"><div class="section-heading"><div><span class="section-kicker">EXPLORE YOUR LIBRARY</span><h2 id="subjects-heading">Subjects</h2></div><span class="section-count">{String(subjects.length).padStart(2, '0')} subjects</span></div><div class="subject-grid">{subjects.map((subject, index) => <SubjectCard subject={subject} index={index} />)}</div></section>

    <section class="recent-section" aria-labelledby="recent-heading"><div class="section-heading"><div><span class="section-kicker">FRESH PAGES</span><h2 id="recent-heading">Recent lessons</h2></div><span class="section-assist">Keep your momentum</span></div>{recent.length ? <div class="recent-list">{recent.map((lesson, index) => <a class="recent-row" href={lesson.url}><span class="recent-index">{String(index + 1).padStart(2, '0')}</span><span class="recent-main"><strong>{lesson.title}</strong><small>{lesson.subjectName}</small></span><span class="recent-date">{lesson.date || 'Undated'}</span><span class="recent-arrow" aria-hidden="true">↗</span></a>)}</div> : <div class="empty-state">Add a lesson to a subject to see it here.</div>}</section>
  </div>
  <script>
    import '../scripts/continue-learning.ts';
    import '../scripts/study-dashboard.ts';
  </script>
</BaseLayout>
